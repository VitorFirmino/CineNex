generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model MaterializedSummary {
  id          String   @id
  payload     String   @db.Text
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model Profile {
  id             String     @id // Supabase Auth User ID
  email          String     @unique
  role           String     @default("USER") // ADMIN, USER
  favorites      Favorite[]
  lastActive     DateTime   @default(now())
  currentContent String?    // Título ou ID do que está assistindo agora
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String   // MOVIE, SERIES
  contentId String   // TMDB ID do conteúdo
  createdAt DateTime @default(now())

  @@unique([profileId, type, contentId])
}

model WatchProgress {
  id          String   @id @default(cuid())
  profileId   String
  contentType String   // movies, series
  contentId   String
  episodeId   String?
  progressPct Float?
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([profileId, contentType, contentId, episodeId])
}

model MaintenanceState {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now())
}
